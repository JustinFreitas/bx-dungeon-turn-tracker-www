# bx-dungeon-turn-tracker-www configuration
# Copy to .env and fill in. .env is gitignored — never commit real values.

PORT=3000

# Admin key for privileged tracker operations. Required: ecosystem.config.js
# refuses to start without it, rather than letting index.js fall back to its
# well-known 'dungeon-master' default.
#
# Generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_KEY=

# TLS material. Absolute paths; the app serves plain HTTP if either is missing.
SSL_CERT=C:/Users/YOUR_USERNAME/AppData/Local/FoundryVTT-Gygax75/Config/your.crt
SSL_KEY=C:/Users/YOUR_USERNAME/AppData/Local/FoundryVTT-Gygax75/Config/your.key
